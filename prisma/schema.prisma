generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  WAREHOUSE
  PRODUCTION
  ACCOUNTING
  SALES
  FACTORY
}

enum Currency {
  TRY
  USD
}

enum StockMovementType {
  PURCHASE
  TRANSFER
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  LOSS
  RECEIPT
}

enum OrderStatus {
  NEW
  CONFIRMED
  STOCK_CHECK
  PREPARING
  READY
  SHIPPED
  COMPLETED
  CANCELLED
}

enum MaterialRequestStatus {
  REQUESTED
  APPROVED
  ORDERED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum EvidenceStage {
  SHIPMENT
  FACTORY_RECEIPT
  PRODUCTION_DELIVERY
  WAREHOUSE_RECEIPT
}

enum PaymentDirection {
  PAYMENT
  COLLECTION
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  passwordHash   String
  role           Role            @default(WAREHOUSE)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  movements      StockMovement[]
  auditLogs      AuditLog[]
  orders         CustomerOrder[]
  materialRequests MaterialRequest[]
  evidencePhotos EvidencePhoto[]
  payments       Payment[]
}

model Material {
  id             String                 @id @default(cuid())
  name           String
  sku            String                 @unique
  category       String
  unit           String
  minimumStock   Decimal                @db.Decimal(14, 3)
  criticalStock  Decimal                @db.Decimal(14, 3)
  supplier       String?
  active         Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  prices         MaterialPriceHistory[]
  stocks         WarehouseStock[]
  components     ProductComponent[]
  movements      StockMovement[]
  requests       MaterialRequest[]
}

model MaterialPriceHistory {
  id              String   @id @default(cuid())
  materialId      String
  amount          Decimal  @db.Decimal(14, 4)
  currency        Currency
  exchangeRate    Decimal  @db.Decimal(14, 6)
  convertedAmount Decimal  @db.Decimal(14, 4)
  validFrom       DateTime @default(now())
  material        Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  @@index([materialId, validFrom])
}

model Product {
  id          String             @id @default(cuid())
  name        String
  brand       String?
  sku         String             @unique
  barcode     String?            @unique
  volumeMl    Decimal?           @db.Decimal(10, 2)
  salePrice   Decimal?           @db.Decimal(14, 4)
  currency    Currency?
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  components  ProductComponent[]
  stocks      WarehouseStock[]
  orderItems  CustomerOrderItem[]
  movements   StockMovement[]
}

model ProductComponent {
  id         String   @id @default(cuid())
  productId  String
  materialId String
  quantity   Decimal  @db.Decimal(14, 3)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id])
  @@unique([productId, materialId])
}

model Warehouse {
  id        String           @id @default(cuid())
  name      String
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  stocks    WarehouseStock[]
  movementsFrom StockMovement[] @relation("sourceWarehouse")
  movementsTo   StockMovement[] @relation("targetWarehouse")
}

model WarehouseStock {
  id          String     @id @default(cuid())
  warehouseId String
  materialId  String?
  productId   String?
  quantity    Decimal    @db.Decimal(14, 3)
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  material    Material?  @relation(fields: [materialId], references: [id])
  product     Product?   @relation(fields: [productId], references: [id])
  @@unique([warehouseId, materialId, productId])
  @@index([warehouseId])
}

model StockMovement {
  id                String             @id @default(cuid())
  type              StockMovementType
  quantity          Decimal            @db.Decimal(14, 3)
  unitCost          Decimal?           @db.Decimal(14, 4)
  currency          Currency?
  exchangeRate      Decimal?           @db.Decimal(14, 6)
  reference         String?
  description       String?
  userId            String
  sourceWarehouseId String?
  targetWarehouseId String?
  materialId        String?
  productId         String?
  createdAt         DateTime           @default(now())
  user              User               @relation(fields: [userId], references: [id])
  sourceWarehouse   Warehouse?         @relation("sourceWarehouse", fields: [sourceWarehouseId], references: [id])
  targetWarehouse   Warehouse?         @relation("targetWarehouse", fields: [targetWarehouseId], references: [id])
  material          Material?          @relation(fields: [materialId], references: [id])
  product           Product?           @relation(fields: [productId], references: [id])
  @@index([createdAt])
  @@index([materialId])
  @@index([productId])
}

model Factory {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  address   String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Customer {
  id        String          @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  address   String?
  notes     String?
  currency  Currency        @default(TRY)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  orders    CustomerOrder[]
}

model CustomerOrder {
  id          String              @id @default(cuid())
  orderNo     String              @unique
  customerId  String
  createdById String
  status      OrderStatus         @default(NEW)
  currency    Currency
  total       Decimal             @db.Decimal(14, 4)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  customer    Customer            @relation(fields: [customerId], references: [id])
  createdBy   User                @relation(fields: [createdById], references: [id])
  items       CustomerOrderItem[]
  @@index([customerId, status])
}

model CustomerOrderItem {
  id        String        @id @default(cuid())
  orderId   String
  productId String
  quantity  Decimal       @db.Decimal(14, 3)
  unitPrice Decimal       @db.Decimal(14, 4)
  order     CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id])
}

model MaterialRequest {
  id            String                @id @default(cuid())
  requestNo     String                @unique
  materialId    String
  requestedById String
  quantity      Decimal               @db.Decimal(14, 3)
  unit          String
  status        MaterialRequestStatus @default(REQUESTED)
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  material      Material              @relation(fields: [materialId], references: [id])
  requestedBy   User                  @relation(fields: [requestedById], references: [id])
  @@index([status, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  body      String
  entity    String?
  entityId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([userId, read, createdAt])
}

model EvidencePhoto {
  id             String        @id @default(cuid())
  stage          EvidenceStage
  fileName       String
  storagePath    String
  mimeType       String
  size           Int
  uploadedById   String
  relatedType    String
  relatedId      String
  createdAt      DateTime      @default(now())
  uploadedBy     User          @relation(fields: [uploadedById], references: [id])
  @@index([relatedType, relatedId, stage])
}

model Payment {
  id          String          @id @default(cuid())
  partyName   String
  amount      Decimal         @db.Decimal(14, 4)
  currency    Currency
  direction   PaymentDirection
  description String?
  createdById String
  createdAt   DateTime        @default(now())
  createdBy   User            @relation(fields: [createdById], references: [id])
  @@index([partyName, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  @@index([entity, entityId])
  @@index([createdAt])
}

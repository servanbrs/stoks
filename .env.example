# Hostinger MySQL bağlantısı
# Hostinger hPanel'deki Database Management bölümünden alınır.
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"

# Authentication aşamasında kullanılacak güçlü, rastgele secret
AUTH_SECRET="change-this-to-a-long-random-secret"

# Dosya yükleme: ilk aşamada local, production'da S3/Cloudinary/Supabase Storage
STORAGE_DRIVER="local"

# Canlı kur alınamazsa kullanılacak USD/TRY yedek değeri
USD_TRY_RATE="41.25"

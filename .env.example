# PostgreSQL bağlantısı (Neon, Supabase, Railway veya yerel PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/stoks?schema=public"

# Pooling kullanan sağlayıcılarda migration için doğrudan bağlantı
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/stoks?schema=public"

# Authentication aşamasında kullanılacak güçlü, rastgele secret
AUTH_SECRET="change-this-to-a-long-random-secret"

# Dosya yükleme: ilk aşamada local, production'da S3/Cloudinary/Supabase Storage
STORAGE_DRIVER="local"
